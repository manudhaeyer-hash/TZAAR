import java.util.*;

class Player {
    static class Hex {
        int q, r, s, owner, type, height;
        Hex(int q, int r, int owner, int type, int height) {
            this.q = q; this.r = r; this.s = -q-r;
            this.owner = owner; this.type = type; this.height = height;
        }
        int distance(Hex b) {
            return (Math.abs(q - b.q) + Math.abs(r - b.r) + Math.abs(s - b.s)) / 2;
        }
    }
    
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        int myId = in.nextInt();
        
        while (true) {
            int phase = in.nextInt();
            int pieceCount = in.nextInt();
            List<Hex> pieces = new ArrayList<>();
            for (int i = 0; i < pieceCount; i++) {
                pieces.add(new Hex(in.nextInt() - 4, in.nextInt() - 4, in.nextInt(), in.nextInt(), in.nextInt()));
            }
            
            if (phase == 2) {
                String move2 = null;
                for (Hex my : pieces) {
                    if (my.owner != myId) continue;
                    for (Hex opp : pieces) {
                        if (opp.owner != myId || my == opp) continue;
                        if (my.distance(opp) == 1 && !(opp.q == 0 && opp.r == 0)) {
                            move2 = String.format("MOVE %d %d %d %d", my.q + 4, my.r + 4, opp.q + 4, opp.r + 4);
                            break;
                        }
                    }
                    if (move2 != null) break;
                }
                if (move2 != null) {
                    System.out.println(move2);
                } else {
                    System.out.println("WAIT");
                }
                continue;
            }
            
            String move1 = null;
            for (Hex my : pieces) {
                if (my.owner != myId) continue;
                for (Hex opp : pieces) {
                    if (opp.owner == myId) continue;
                        if (my.height >= opp.height) {
                        if (my.distance(opp) == 1 && !(opp.q == 0 && opp.r == 0)) {
                            move1 = String.format("MOVE %d %d %d %d", my.q + 4, my.r + 4, opp.q + 4, opp.r + 4);
                            break;
                        }
                    }
                }
                if (move1 != null) break;
            }
            
            if (move1 == null) {
                for (Hex my : pieces) {
                    if (my.owner != myId) continue;
                    for (Hex opp : pieces) {
                        if (opp.owner == myId) continue;
                        if (my.height >= opp.height) {
                            if (isAligned(my, opp) && isPathClear(my, opp, pieces)) {
                                move1 = String.format("MOVE %d %d %d %d", my.q + 4, my.r + 4, opp.q + 4, opp.r + 4);
                                break;
                            }
                        }
                    }
                    if (move1 != null) break;
                }
            }
            
            if (move1 != null) {
                System.out.println(move1);
            } else {
                System.out.println("WAIT");
            }
        }
    }
    
    static boolean isAligned(Hex a, Hex b) {
        return a.q == b.q || a.r == b.r || a.s == b.s;
    }
    
    static boolean isPathClear(Hex a, Hex b, List<Hex> pieces) {
        if (!isAligned(a, b)) return false;
        int dist = a.distance(b);
        if (dist == 0) return true;
        
        int dq = (b.q - a.q) / dist;
        int dr = (b.r - a.r) / dist;
        
        int cq = a.q + dq;
        int cr = a.r + dr;
        
        while (cq != b.q || cr != b.r) {
            if (cq == 0 && cr == 0) return false;
            for (Hex p : pieces) {
                if (p.q == cq && p.r == cr) return false;
            }
            cq += dq;
            cr += dr;
        }
        return true;
    }
}
